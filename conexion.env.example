# Copiar a conexion.env en tu máquina; NO subirlo a GitHub ni compartirlo.
# Preferir ~/.pgpass (Linux/macOS) o %APPDATA%\postgresql\pgpass.conf (Windows).
# No colocar contraseñas en la línea de comandos. Los tres nombres de BD son placeholders.
export USERS_DSN="host=127.0.0.1 port=15432 dbname=postgres user=postgres password='#BrandNewDay2026' sslmode=require"
export CATALOG_DSN="host=127.0.0.1 port=15432 dbname=catalogservice_db user=postgres password='#BrandNewDay2026' sslmode=require"
export RATE_DSN="host=127.0.0.1 port=15432 dbname=rate user=postgres password='#BrandNewDay2026' sslmode=require"
# Para verificar la identidad TLS: sustituir require por verify-full y añadir sslrootcert=/ruta/ca.pem.
